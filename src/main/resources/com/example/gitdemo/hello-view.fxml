<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="531.0" prefWidth="307.0" spacing="20.0" style="-fx-background-color: navy blue;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo16.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Logjin" textFill="WHITE" translateY="50.0">
        <font>
            <Font size="36.0" />
        </font></Label>

    <Label fx:id="welcomeText" prefHeight="17.0" prefWidth="245.0" text="Please enter your login and you password" textFill="#fcfcfc" translateX="3.0" translateY="30.0" />
