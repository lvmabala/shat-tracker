    <TextField promptText="Username or email" translateY="1.0" />
    <TextField promptText="Password" translateY="1.0" />
    <Label prefHeight="17.0" prefWidth="128.0" scaleZ="10.0" text="Forgot password ?" textFill="#fffefe" translateX="90.0" translateZ="10.0" />
    <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="274.0" text="Or sign-in with Google " translateY="50.0" />
    <Label scaleZ="10.0" text="register" translateX="70.0" translateY="50.0" />
    <Label prefHeight="17.0" prefWidth="110.0" text="Not a member yet?" textFill="WHITE" translateY="13.0" />
    <Region prefHeight="200.0" prefWidth="200.0" />
</VBox>
